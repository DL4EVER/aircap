<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:paddingBottom="16dp"
            android:textSize="15sp" />

        <Switch
            android:id="@+id/swEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="20dp"
            android:text="启用音量上限"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/tvCapValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:textSize="17sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/sbCap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:min="5"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/tvCurrentVol"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="20dp"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="无障碍设置（拦截手机音量键）" />

        <Button
            android:id="@+id/btnBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="申请电池优化白名单" />

        <Button
            android:id="@+id/btnAppInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="应用详情（自启动 / 电池管理）" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:paddingTop="16dp"
            android:text="@string/tips"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
